{
  "name": "editha-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend di Editha: API dei file di /config, raggiungibile solo via Ingress",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test \".test-dist/test/**/*.test.js\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.12",
    "fastify": "5.12.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
