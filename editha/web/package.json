{
  "name": "editha-web",
  "version": "0.2.0",
  "private": true,
  "description": "Interfaccia di Editha: albero dei file, tab ed editor CodeMirror 6",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test \".test-dist/test/**/*.test.js\"",
    "test:e2e": "npm run build && npm --prefix ../server run build && playwright test",
    "screenshots": "npm run build && npm --prefix ../server run build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-jinja": "6.0.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@mdi/js": "7.4.47",
    "@replit/codemirror-indentation-markers": "6.5.3",
    "lit": "3.3.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "esbuild-wasm": "0.28.2",
    "typescript": "5.9.3"
  }
}
